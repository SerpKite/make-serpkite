{
  "url": "/v1/webpage",
  "method": "POST",
  "type": "json",
  "body": {
    "url": "{{parameters.url}}",
    "include_html": "{{parameters.include_html}}",
    "include_links": "{{parameters.include_links}}",
    "include_images": "{{parameters.include_images}}",
    "country": "{{parameters.country}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
