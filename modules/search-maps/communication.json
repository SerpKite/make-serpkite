{
  "url": "/v1/maps",
  "method": "GET",
  "qs": {
    "q": "{{parameters.q}}",
    "country": "{{parameters.country}}",
    "language": "{{parameters.language}}",
    "location": "{{parameters.location}}"
  },
  "response": {
    "limit": "{{parameters.limit}}",
    "iterate": "{{body.results}}",
    "output": "{{item}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{length(body.results) > 0 && body.request.page < 10}}"
  }
}
