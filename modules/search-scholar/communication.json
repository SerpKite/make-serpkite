{
  "url": "/v1/scholar",
  "method": "POST",
  "type": "json",
  "body": {
    "q": "{{parameters.q}}",
    "country": "{{parameters.country}}",
    "language": "{{parameters.language}}",
    "page": 1
  },
  "response": {
    "iterate": "{{body.results}}",
    "limit": "{{parameters.limit}}",
    "output": {
      "position": "{{item.position}}",
      "title": "{{item.title}}",
      "link": "{{item.link}}",
      "snippet": "{{item.snippet}}",
      "publication_info": "{{item.publication_info}}",
      "year": "{{item.year}}",
      "pdf_url": "{{item.pdf_url}}",
      "id": "{{item.id}}"
    }
  },
  "pagination": {
    "body": {
      "q": "{{parameters.q}}",
      "country": "{{parameters.country}}",
      "language": "{{parameters.language}}",
      "page": "{{pagination.page}}"
    },
    "condition": "{{length(body.results) > 0 && pagination.page <= 10}}"
  }
}
