        "value": "POST"
      },
      {
        "label": "PATCH",
        "value": "PATCH"
      },
      {
        "label": "DELETE",
        "value": "DELETE"
      }
    ]
  },
  {
    "name": "headers",
    "label": "Headers",
    "type": "array",
    "spec": [
      {
        "name": "key",
        "label": "Key",
        "type": "text"
      },
      {
